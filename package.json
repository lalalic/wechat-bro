{
  "name": "wechat-bro",
  "version": "1.2.0",
  "description": "AI agent interface for WeChat Web — send/receive messages, manage contacts, upload media, transcribe voice",
  "type": "commonjs",
  "bin": {
    "wechat-bro": "./src/cli.js"
  },
  "files": [
    "src/",
    "skills/",
    "README.md"
  ],
  "scripts": {
    "start": "node src/cli.js",
    "test": "node test/test-inject.js",
    "push": "GIT_SSH_COMMAND=\"ssh -i ~/.ssh/id_ed25519_1 -o IdentitiesOnly=yes\" git push",
    "postinstall": "node -e \"const p=require('path'),o=require('os'),d=p.join(o.homedir(),'.wechat-bro','chromium');process.env.PUPPETEER_CACHE_DIR=d;const pup=require('puppeteer');(async()=>{try{await pup.executablePath()}catch{require('child_process').execSync('npx @puppeteer/browsers install chrome@stable --path \\\"'+d+'\\\"',{stdio:'inherit',timeout:300000})}})()\""
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "puppeteer": "^25.4.0",
    "ws": "^8.21.1"
  },
  "pi":{
    "skills": ["./skills/"],
    "extensions": ["./skills/wechat-bro/.pi/extensions/"],
    "subagents": {"agents": ["./skills/wechat-bro/.pi/agents/"], "chains": ["./skills/wechat-bro/.pi/chains/"]}
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lalalic/wechat-bro.git"
  },
  "keywords": [
    "wechat",
    "weixin",
    "chatbot",
    "agent",
    "ai",
    "copilot",
    "wx.qq.com"
  ],
  "license": "MIT"
}
